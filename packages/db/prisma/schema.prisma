generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Append-only: rows are only ever created, never updated or deleted, so this
// stays a durable record of bot usage even if Patient rows get reassigned/reseeded.
model BotEvent {
  id         String   @id @default(cuid())
  telegramId String
  username   String?
  name       String?
  type       String   @default("start")
  createdAt  DateTime @default(now())

  @@index([telegramId])
}

model Clinic {
  id            String   @id @default(cuid())
  name          String
  licenseActive Boolean  @default(true)
  createdAt     DateTime @default(now())

  doctors  Doctor[]
  patients Patient[]
}

model Doctor {
  id           String   @id @default(cuid())
  // Null for a solo practitioner (practiceType = "solo"). A clinic doctor
  // always has one. See lib/practiceType.ts for the allowed values.
  clinicId     String?
  practiceType String   @default("clinic")
  email        String   @unique
  passwordHash String
  name         String
  // Short code a patient enters to request a connection to this doctor
  // (the mirror of Patient.inviteCode for the other direction).
  connectCode  String   @unique
  createdAt    DateTime @default(now())

  // Brute-force protection for /api/login. Counter resets on any successful
  // login; on reaching the threshold `lockedUntil` is set and the account
  // refuses logins until it passes.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  clinic                Clinic?      @relation(fields: [clinicId], references: [id])
  sessions              Session[]
  careLinks             CareLink[]
  encounters            Encounter[]
  prescribedMedications Medication[]
}

// Opaque server-side sessions for the doctor web panel. The cookie holds a
// random token; `id` is its SHA-256 hash, so a DB leak alone can't be used to
// impersonate anyone. Deleting rows here revokes access immediately (logout,
// "sign out everywhere", offboarding).
model Session {
  id        String   @id
  doctorId  String
  createdAt DateTime @default(now())
  expiresAt DateTime

  doctor Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@index([doctorId])
  @@index([expiresAt])
}

model Patient {
  id         String    @id @default(cuid())
  clinicId   String?
  name       String
  birthDate  DateTime?
  telegramId String?   @unique
  inviteCode String    @unique
  anamnesis  String?
  createdAt  DateTime  @default(now())

  // Optional email + password login for the web portal (/app), independent of
  // Telegram: a patient may have Telegram only, a password only, or both linked
  // to the same row. Null passwordHash = no web login set up yet.
  email        String? @unique
  passwordHash String?

  // Brute-force protection for /api/app/login, mirroring Doctor. Counter resets
  // on any successful login; on reaching the threshold `lockedUntil` is set and
  // the account refuses logins until it passes.
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?

  // Data-processing consent captured in the Mini App onboarding. `consentAt`
  // is when the patient accepted; `consentVersion` is which text they saw
  // (lib/consent.ts CONSENT_VERSION) so a text change can re-prompt.
  consentAt      DateTime?
  consentVersion String?

  // Living summary, edited in place. `anamnesisUpdatedAt` / `...ById` record the
  // last change; the encounter history below is the append-only record.
  anamnesisUpdatedAt   DateTime?
  anamnesisUpdatedById String?

  clinic          Clinic?                @relation(fields: [clinicId], references: [id])
  careLinks       CareLink[]
  encounters      Encounter[]
  checkIns           CheckIn[]
  responses          QuestionnaireResponse[]
  questionnaireDrafts QuestionnaireDraft[]
  medications        Medication[]
  medicationReports  MedicationReport[]
  thoughts           Thought[]
  patientSessions    PatientSession[]
}

// One visit / contact note. Append-only: rows are created, never edited or
// deleted, so the record stays trustworthy (corrections are added as a new
// entry). Loose SOAP — every text field is optional; `type` and `date` are not.
//
//   type: visit | consult | phone | note
model Encounter {
  id           String   @id @default(cuid())
  patientId    String
  doctorId     String
  date         DateTime
  type         String   @default("visit")
  complaints   String?
  observations String?
  assessment   String?
  plan         String?
  note         String?
  createdAt    DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id])

  @@index([patientId])
}

// A patient <-> doctor connection with an explicit lifecycle. Either side can
// request it, the other confirms. The patient can Pause (instant, reversible —
// stops new data reaching the doctor) or End (a cooling-off window: status
// "ending" until `endsAt`, still reversible by the patient, then "ended").
// `managedByClinic` links (e.g. a dispensary) can't be ended by the patient
// unilaterally.
//
//   status: pending | active | paused | ending | ended | declined
//   requestedBy: patient | doctor
model CareLink {
  id              String    @id @default(cuid())
  patientId       String
  doctorId        String
  status          String    @default("pending")
  requestedBy     String
  managedByClinic Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  activatedAt     DateTime?
  endsAt          DateTime?
  endedAt         DateTime?

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctor  Doctor  @relation(fields: [doctorId], references: [id], onDelete: Cascade)

  @@unique([patientId, doctorId])
  @@index([patientId])
  @@index([doctorId])
  @@index([status])
}

// Opaque server-side sessions for the patient web portal (/app), mirroring
// Session for doctors: the cookie holds a random token, `id` is its SHA-256
// hash, so a DB leak alone can't impersonate anyone. Deleting rows revokes
// access immediately.
model PatientSession {
  id        String   @id
  patientId String
  createdAt DateTime @default(now())
  expiresAt DateTime

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@index([patientId])
  @@index([expiresAt])
}

model CheckIn {
  id         String   @id @default(cuid())
  patientId  String
  date       DateTime @default(now())
  mood       Int
  sleepHours Float?
  energyLevel Int?
  medsTaken  Boolean?
  note       String?

  patient Patient @relation(fields: [patientId], references: [id])
}

model Questionnaire {
  id          String @id @default(cuid())
  code        String @unique
  title       String
  description String?

  responses QuestionnaireResponse[]
}

model QuestionnaireResponse {
  id              String   @id @default(cuid())
  patientId       String
  questionnaireId String
  score           Int
  answers         String
  completedAt     DateTime @default(now())

  patient       Patient       @relation(fields: [patientId], references: [id])
  questionnaire Questionnaire @relation(fields: [questionnaireId], references: [id])
}

// A questionnaire the patient started but hasn't submitted. Autosaved on every
// answer so they can leave and resume. Deleted on submit or discard.
// `answers` is a JSON array of option values, indexed by question order.
model QuestionnaireDraft {
  id                String   @id @default(cuid())
  patientId         String
  questionnaireCode String
  answers           String   @default("[]")
  lastIndex         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  patient Patient @relation(fields: [patientId], references: [id], onDelete: Cascade)

  @@unique([patientId, questionnaireCode])
}

// A course of a medication, not just a current-list row. Never deleted:
// stopping a course sets `endedAt` + status, so the history stays intact.
//
//   status:        active | stopped | switched
//   prescriberType: self | doctor | external
model Medication {
  id             String    @id @default(cuid())
  patientId      String
  name           String
  dosage         String
  frequency      Int
  reason         String?
  status         String    @default("active")
  prescriberType String    @default("self")
  prescriberDoctorId String?
  startedAt      DateTime  @default(now())
  endedAt        DateTime?
  createdAt      DateTime  @default(now())

  patient          Patient            @relation(fields: [patientId], references: [id])
  prescriberDoctor Doctor?            @relation(fields: [prescriberDoctorId], references: [id])
  reports          MedicationReport[]

  @@index([patientId])
}

// Patient's own account of how a medication is going. Surfaces on the doctor's
// card next to the course.
model MedicationReport {
  id              String   @id @default(cuid())
  medicationId    String
  patientId       String
  date            DateTime @default(now())
  tolerability    Int?
  perceivedBenefit Int?
  sideEffects     String?
  sideEffectTags  String?
  note            String?
  createdAt       DateTime @default(now())

  medication Medication @relation(fields: [medicationId], references: [id], onDelete: Cascade)
  patient    Patient    @relation(fields: [patientId], references: [id])

  @@index([medicationId])
}

model Thought {
  id        String   @id @default(cuid())
  patientId String
  content   String
  createdAt DateTime @default(now())

  patient Patient @relation(fields: [patientId], references: [id])
}
