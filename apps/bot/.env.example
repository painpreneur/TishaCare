# ─────────────────────────────────────────────────────────────────────────────
# apps/bot — ЛОКАЛЬНЫЙ dev-бот (long-polling). Продакшен обслуживает вебхук
# внутри apps/web, этот процесс не деплоится. См. docs/ENVIRONMENTS.md.
# ─────────────────────────────────────────────────────────────────────────────

# Контур: должен быть local (или staging). При APP_ENV=production процесс
# откажется стартовать — иначе polling вызовет deleteWebhook и перехватит
# боевой трафик на эту машину.
APP_ENV=local

# Токен dev-бота (@…_dev_bot), НЕ боевого. Отдельный бот на контур.
TELEGRAM_BOT_TOKEN=

# Postgres этого контура — локальная БД или личная ветка Neon.
# НИКОГДА не боевая строка. См. packages/db/.env.example.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Публичный HTTPS-адрес веб-панели (apps/web). Весь функционал бота — через
# Mini App, так что переменная обязательна. Telegram не откроет http://localhost
# на реальном устройстве — нужен туннель (ngrok, cloudflared).
WEBAPP_URL=

# Локальные напоминания через node-cron. По умолчанию выключены: в
# prod/staging их шлёт Vercel Cron, и при общей БД получились бы дубли.
# Поставь "1", только чтобы проверить сценарий против локальной БД.
ENABLE_LOCAL_REMINDERS=

# Telegram id для уведомлений о новом пациенте. Необязательно; ставь СВОЙ,
# чтобы не спамить боевого админа. Узнать id — у @userinfobot.
ADMIN_TELEGRAM_ID=
