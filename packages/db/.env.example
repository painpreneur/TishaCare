# ─────────────────────────────────────────────────────────────────────────────
# packages/db — переменные для Prisma CLI (migrate / studio / seed).
# Значения РАЗНЫЕ на каждом контуре. Полное описание — docs/ENVIRONMENTS.md.
# Никогда не кладите сюда боевую строку: прод-БД доступна только из Vercel
# Production env.
# ─────────────────────────────────────────────────────────────────────────────

# Postgres этого контура. Локально — своя БД (`createdb tishacare`) или личная
# ветка Neon. staging — ветка Neon staging. Прод — только в Vercel.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Прямое (НЕ пуленое) подключение к тому же Postgres — нужно Prisma Migrate для
# session-lock, которого нет через пулер Neon (хост `-pooler`).
# Локально/CI (без пулера) = DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
