# Postgres — локально можно поднять через `brew install postgresql@14`,
# в продакшене — Neon/Supabase/Railway Postgres и т.п.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Тот же токен, что и в apps/bot/.env — нужен для проверки подписи
# initData Telegram Mini App (см. lib/telegramAuth.ts).
TELEGRAM_BOT_TOKEN=

# Только для локальной разработки: включает вход в Mini App через
# заголовок X-Dev-Telegram-Id без реальной сессии Telegram. НЕ включать
# ни в одном окружении, доступном пациентам.
MINIAPP_DEV_BYPASS=

# Опционально — включает чат поддержки (/miniapp/support). Без ключа
# страница отвечает "GPT-поддержка сейчас недоступна".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Публичный HTTPS-адрес этого же деплоя (используется ботом, чтобы собрать
# ссылку на Mini App в кнопке под сообщением) — например
# https://web-three-lime-26.vercel.app.
WEBAPP_URL=

# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token на
# /api/bot/webhook — передаётся в Telegram при регистрации вебхука
# (setWebhook ?secret_token=...). Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Секрет для авторизации вызовов /api/cron/reminders. Vercel Cron Jobs сам
# подставляет `Authorization: Bearer $CRON_SECRET`, если эта переменная
# задана в проекте — см. https://vercel.com/docs/cron-jobs/manage-cron-jobs
CRON_SECRET=
