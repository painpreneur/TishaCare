TELEGRAM_BOT_TOKEN=

# Тот же Postgres, что и у apps/web — см. apps/web/.env.example.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Публичный HTTPS-адрес веб-панели (apps/web) — весь функционал бота работает
# только через эту Mini App, так что переменная обязательна. Telegram не
# откроет обычный http://localhost на реальном устройстве — для локальной
# разработки нужен туннель (ngrok, cloudflared и т.п.).
WEBAPP_URL=
