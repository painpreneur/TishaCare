# ─────────────────────────────────────────────────────────────────────────────
# apps/web — переменные окружения. Значения РАЗНЫЕ на каждом контуре
# (production / staging / local). Полное описание — docs/ENVIRONMENTS.md.
# На Vercel задаются в Project Settings → Environment Variables по
# окружениям (Production / Preview). Локально — в apps/web/.env.local.
# ─────────────────────────────────────────────────────────────────────────────

# Контур, в котором работает процесс: production | staging | local.
# Если не задано — на деплоях Vercel выводится из VERCEL_ENV, иначе local.
# production включает жёсткие проверки (напр. запрет MINIAPP_DEV_BYPASS).
APP_ENV=local

# Postgres ЭТОГО контура. Прод-строка живёт ТОЛЬКО в Vercel Production env,
# её не должно быть ни в одном локальном .env. Локально — своя БД
# (`createdb mindsteady`) или личная ветка Neon. staging — ветка Neon staging.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Прямое (НЕ пуленое) подключение к тому же Postgres. Использует только
# Prisma CLI: `vercel-build` вызывает `prisma migrate deploy` перед сборкой,
# а миграциям нужен session-lock, недоступный через пулер Neon (хост `-pooler`).
# На Vercel задать в Production и Preview. Локально/CI (без пулера) = DATABASE_URL.
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

# Токен Telegram-бота ЭТОГО контура (свой бот на каждый контур):
#   production — боевой @…bot, staging — @…_staging_bot, local — @…_dev_bot.
# Нужен и боту, и веб-панели: ею проверяется подпись initData Mini App.
TELEGRAM_BOT_TOKEN=

# Вход в Mini App через заголовок X-Dev-Telegram-Id без подписи Telegram —
# для открытия мини-аппа из обычного браузера. Только staging/local.
# При APP_ENV=production приложение упадёт при старте, если здесь "1".
MINIAPP_DEV_BYPASS=

# Опционально — включает чат поддержки (/miniapp/support). Без ключа
# страница отвечает "GPT-поддержка сейчас недоступна".
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Публичный HTTPS-адрес ЭТОГО деплоя (бот строит из него ссылку на Mini App
# в кнопке). production — боевой домен, staging — постоянный алиас Preview,
# local — адрес туннеля (ngrok/cloudflared).
WEBAPP_URL=

# Секрет для проверки заголовка X-Telegram-Bot-Api-Secret-Token на
# /api/bot/webhook — передаётся в Telegram при setWebhook ?secret_token=…
# Свой на контур. Сгенерировать: openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# Секрет авторизации вызовов /api/cron/reminders. Vercel Cron сам
# подставляет `Authorization: Bearer $CRON_SECRET`, если переменная задана
# в проекте — https://vercel.com/docs/cron-jobs/manage-cron-jobs
CRON_SECRET=

# Telegram id (числовой), которому бот шлёт уведомление о каждом новом
# пациенте (первый /start). Необязательно. На staging/local ставь СВОЙ id,
# чтобы не спамить боевого админа. Узнать id — у @userinfobot.
ADMIN_TELEGRAM_ID=
